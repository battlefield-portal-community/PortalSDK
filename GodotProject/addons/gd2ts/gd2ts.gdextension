[configuration]
entry_symbol = "gd2ts_library_init"
compatibility_minimum = "4.1"

[libraries]
linux.debug.x86_64 = "res://addons/gd2ts/bin/libgd2ts.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/gd2ts/bin/libgd2ts.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/gd2ts/bin/libgd2ts.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/gd2ts/bin/libgd2ts.windows.template_release.x86_64.dll"
macos.debug = "res://addons/gd2ts/bin/libgd2ts.macos.template_debug.framework"
macos.release = "res://addons/gd2ts/bin/libgd2ts.macos.template_release.framework"
